---
import { Image } from 'astro:assets';
import { getCollection, getEntry } from 'astro:content';
import shining from '../../assets/img/shining.jpg';
import PageHero from '../../components/PageHero.astro';
import Base from '../../layouts/Base.astro';
import { pathsFor, type Locale } from '../../i18n';
import { pickText, usePageText } from '../../lib/content';

export const getStaticPaths = () => pathsFor('opportunities');

type Props = { lang: Locale };
const { lang } = Astro.props;

const page = await getEntry('pages', 'opportunities');
if (!page) throw new Error('Falta src/content/pages/opportunities.json');
const t = usePageText(page.data, 'opportunities', lang);

const [opportunity] = (await getCollection('opportunities', (o) => o.data.status === 'abierta')).sort(
  (a, b) => a.data.order - b.data.order
);
const archive = (await getCollection('archive')).sort((a, b) => a.data.order - b.data.order);

const site = await getEntry('config', 'site');

/* Los cuatro datos de la convocatoria van con su propio dibujo, en el mismo
   orden que en la ficha. */
const FACT_ICONS = [
  '<circle cx="9" cy="8" r="3"/><circle cx="17" cy="9" r="2.5"/><path d="M3 19a6 6 0 0112 0M15 19c0-2 .8-3.8 2-5"/>',
  '<path d="M3 12h18M12 3c2.5 2.5 3.8 5.7 3.8 9S14.5 18.5 12 21"/><circle cx="12" cy="12" r="9"/>',
  '<path d="M4 5h16v14H4zM4 9h16"/>',
  '<path d="M12 2l2.4 7.4H22l-6 4.5 2.3 7.1L12 16.5 5.7 21l2.3-7.1-6-4.5h7.6z"/>',
];
---

<Base lang={lang} page="opportunities" title={t('seo.title')} description={t('seo.description')}>
  <PageHero
    lang={lang}
    crumb="common.crumb.opportunities"
    eyebrow={t('hero.eyebrow')}
    title={t('hero.h1')}
    text={t('hero.p')}
    image={shining}
  />

  {
    opportunity && (
      <section class="section" aria-labelledby="opp-h">
        <div class="wrap">
          <div class="section__head reveal">
            <span class="eyebrow">{t('section.eyebrow')}</span>
            <h2 id="opp-h">{t('section.h2')}</h2>
            <p>{t('section.p')}</p>
          </div>

          <div class="opp reveal">
            <div class="opp__poster">
              {opportunity.data.flag && <span class="flag">{pickText(opportunity.data.flag, lang)}</span>}
              <Image
                src={opportunity.data.poster}
                alt={pickText(opportunity.data.posterAlt, lang)}
                widths={[400, 700]}
                sizes="(max-width: 820px) 100vw, 40vw"
              />
            </div>
            <div class="opp__body">
              <h3>{opportunity.data.title}</h3>
              <span class="opp__where">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M12 21s-7-6.3-7-11a7 7 0 0114 0c0 4.7-7 11-7 11z" />
                  <circle cx="12" cy="10" r="2.5" />
                </svg>
                <span>{pickText(opportunity.data.where, lang)}</span>
              </span>
              <p>{pickText(opportunity.data.summary, lang)}</p>

              {opportunity.data.facts.length > 0 && (
                <div class="opp__facts">
                  {opportunity.data.facts.map((fact, i) => (
                    <div class="opp__fact">
                      <svg
                        width="18"
                        height="18"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        set:html={FACT_ICONS[i] ?? FACT_ICONS[0]}
                      />
                      <span>{pickText(fact, lang)}</span>
                    </div>
                  ))}
                </div>
              )}

              {opportunity.data.findLabel && <p class="opp__find">{pickText(opportunity.data.findLabel, lang)}</p>}
              {opportunity.data.findText && <p class="opp__findtext">{pickText(opportunity.data.findText, lang)}</p>}

              <div class="opp__cta">
                {opportunity.data.signupUrl && (
                  <a class="btn btn--sun" href={opportunity.data.signupUrl} target="_blank" rel="noopener">
                    {t('card.cta1')}
                  </a>
                )}
                {opportunity.data.infopackUrl && (
                  <a class="btn btn--light" href={opportunity.data.infopackUrl} target="_blank" rel="noopener">
                    {t('card.cta2')}
                  </a>
                )}
              </div>
            </div>
          </div>

          {site && (
            <p class="opp-note reveal">
              <span>{t('note.text')}</span> <a href={`mailto:${site.data.email}`}>{site.data.email}</a>
            </p>
          )}
        </div>
      </section>
    )
  }

  <section class="section section--oat" aria-labelledby="arch-h">
    <div class="wrap">
      <div class="section__head reveal">
        <span class="eyebrow">{t('archive.eyebrow')}</span>
        <h2 id="arch-h">{t('archive.h2')}</h2>
        <p>{t('archive.p')}</p>
      </div>
      <div class="archive reveal" aria-label={t('archive.h2')}>
        {archive.map((item) => <span>{item.data.title}</span>)}
      </div>
    </div>
  </section>
</Base>

<style>
  .opp {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    background: linear-gradient(150deg, var(--moss-600), var(--forest-800));
    border-radius: 28px;
    overflow: hidden;
    color: #fff;
    box-shadow: 0 30px 60px -34px rgba(30, 43, 34, 0.7);
  }
  .opp__poster {
    position: relative;
    min-height: 320px;
    background: var(--forest-800);
  }
  .opp__poster .flag {
    position: absolute;
    top: 18px;
    left: 18px;
    z-index: 2;
    background: #fff;
    color: var(--clay-deep);
    font-weight: 800;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    padding: 7px 13px;
    border-radius: 999px;
    text-transform: uppercase;
  }
  .opp__poster :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .opp__body {
    padding: 38px 40px;
  }
  .opp__body h3 {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    margin-bottom: 8px;
  }
  .opp__where {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
    color: var(--sprout);
    margin-bottom: 16px;
    font-size: 0.95rem;
  }
  .opp__body > p {
    color: rgba(255, 255, 255, 0.86);
    margin-bottom: 20px;
  }
  .opp__facts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px 24px;
    margin-bottom: 26px;
  }
  .opp__fact {
    display: flex;
    gap: 11px;
    align-items: flex-start;
    font-size: 0.92rem;
  }
  .opp__fact svg {
    flex: 0 0 auto;
    margin-top: 2px;
    color: var(--sprout);
  }
  .opp__find {
    font-weight: 700;
    margin-bottom: 10px;
  }
  .opp__findtext {
    margin-bottom: 20px;
  }
  .opp__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .opp-note {
    margin-top: 22px;
    color: var(--muted);
    font-size: 0.92rem;
    text-align: center;
  }
  .opp-note a {
    color: var(--moss-600);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .archive {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .archive span {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 9px 15px;
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--forest-800);
  }

  @media (max-width: 820px) {
    .opp {
      grid-template-columns: 1fr;
    }
    .opp__poster {
      min-height: 220px;
    }
    .opp__facts {
      grid-template-columns: 1fr;
    }
  }
</style>
