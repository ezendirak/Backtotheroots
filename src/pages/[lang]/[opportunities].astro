---
import Base from '../../layouts/Base.astro';
import { pathsFor, type Locale } from '../../i18n';

export const getStaticPaths = () => pathsFor('opportunities');

type Props = { lang: Locale };
const { lang } = Astro.props;

/* Fase 1: solo el esqueleto. Ver nota en index.astro. */
const title = 'Oportunidades · TerraTribe 2026 · Back to the Roots';
const description =
  'Inscripciones abiertas para TerraTribe 2026, intercambio juvenil entre España y Francia. Consulta requisitos, fechas y cómo apuntarte.';
---

<Base lang={lang} page="opportunities" title={title} description={description}>
  <section class="section">
    <div class="wrap">
      <h1>Extendemos nuestras ramas</h1>
    </div>
  </section>
</Base>
