---
import Base from '../../layouts/Base.astro';
import { localePaths, type Locale } from '../../i18n';

export const getStaticPaths = localePaths;

type Props = { lang: Locale };
const { lang } = Astro.props;

/* Fase 1: solo el esqueleto. Ver nota en index.astro. */
const title = 'Contacto · Escríbenos · Back to the Roots';
const description =
  'Contacta con Back to the Roots por email o redes sociales. Resolvemos dudas sobre proyectos, colaboraciones y oportunidades de experiencias educativas.';
---

<Base lang={lang} slug="contacto" title={title} description={description}>
  <section class="section">
    <div class="wrap">
      <h1>Ayúdanos a polinizar el cambio</h1>
    </div>
  </section>
</Base>
