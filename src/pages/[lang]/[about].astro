---
import { Image } from 'astro:assets';
import { getCollection, getEntry } from 'astro:content';
import ecoexperiences from '../../assets/img/ecoexperiences.jpg';
import reaction from '../../assets/img/reaction.jpg';
import PageHero from '../../components/PageHero.astro';
import Base from '../../layouts/Base.astro';
import { localePath, pathsFor, type Locale } from '../../i18n';
import { localize, usePageText } from '../../lib/content';

export const getStaticPaths = () => pathsFor('about');

type Props = { lang: Locale };
const { lang } = Astro.props;

const page = await getEntry('pages', 'about');
if (!page) throw new Error('Falta src/content/pages/about.json');
const t = usePageText(page.data, 'about', lang);

const team = (await getCollection('team'))
  .sort((a, b) => a.data.es.order - b.data.es.order)
  .map((m) => localize(m.data, lang));
const lead = team.find((m) => m.lead);
const members = team.filter((m) => !m.lead);
const gallery = (await getCollection('gallery'))
  .sort((a, b) => a.data.es.order - b.data.es.order)
  .map((g) => localize(g.data, lang));

/* Enlace externo al recurso educativo. No es texto en pantalla, por eso no
   está en el contenido; si algún día cambia, se cambia aquí. */
const TOOLKIT_URL = 'https://www.salto-youth.net/tools/toolbox/tool/the-green-playground-toolkit.5875';

const ICONS: Record<string, string> = {
  leaf: '<path d="M12 2C7 5 4 9 4 14a8 8 0 0016 0c0-5-3-9-8-12z"/>',
  music: '<path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/>',
  sprout: '<path d="M12 2C7 5 4 9 4 14a8 8 0 0016 0c0-5-3-9-8-12z"/><path d="M12 22v-8M12 16c-2 0-4-1-5-3"/>',
};

const VALUES = ['v1', 'v2', 'v3', 'v4', 'v5'];
const CHIPS = ['chip1', 'chip2', 'chip3', 'chip4', 'chip5'];
const STATS = [1, 2, 3, 4];
---

<Base lang={lang} page="about" title={t('seo.title')} description={t('seo.description')}>
  <PageHero
    lang={lang}
    crumb="common.crumb.about"
    eyebrow={t('hero.eyebrow')}
    title={t('hero.h1')}
    text={t('hero.p')}
    image={reaction}
  />

  <section class="section" id="quienes" aria-labelledby="quienes-h">
    <div class="wrap">
      <div class="about-lead">
        <div class="reveal">
          <span class="eyebrow">{t('mission.eyebrow')}</span>
          <h2 id="quienes-h">{t('mission.h2')}</h2>
          <p>{t('mission.p1')}</p>
          <p>{t('mission.p2')}</p>
          <p>{t('mission.p3')}</p>
          <div class="values" aria-label={t('mission.eyebrow')}>
            {VALUES.map((v) => <span class="value">{t(`mission.${v}`)}</span>)}
          </div>
        </div>
        <div class="reveal">
          <div class="ph">
            <Image
              src={ecoexperiences}
              alt="Jóvenes de Back to the Roots en una actividad de conexión con la naturaleza"
              widths={[480, 760, 1024]}
              sizes="(max-width: 820px) 100vw, 50vw"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--oat" id="hacemos" aria-labelledby="hacemos-h">
    <div class="wrap">
      <div class="section__head reveal">
        <span class="eyebrow">{t('doing.eyebrow')}</span>
        <h2 id="hacemos-h">{t('doing.h2')}</h2>
        <p>{t('doing.p')}</p>
      </div>
      <div class="pillars">
        <article class="pillar reveal">
          <span class="pillar__n">01</span>
          <div class="pillar__ic">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2C7 5 4 9 4 14a8 8 0 0016 0c0-5-3-9-8-12z"></path>
              <path d="M12 22v-8M12 16c-2 0-4-1-5-3"></path>
            </svg>
          </div>
          <h3>{t('doing.c1t')}</h3>
          <p>{t('doing.c1p')}</p>
        </article>
        <article class="pillar reveal">
          <span class="pillar__n">02</span>
          <div class="pillar__ic">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="9" cy="8" r="3"></circle>
              <circle cx="17" cy="10" r="2.5"></circle>
              <path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6M15.5 20c0-2 .8-3.8 2-5"></path>
            </svg>
          </div>
          <h3>{t('doing.c2t')}</h3>
          <p>{t('doing.c2p')}</p>
        </article>
        <article class="pillar reveal">
          <span class="pillar__n">03</span>
          <div class="pillar__ic">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 18V5l12-2v13"></path>
              <circle cx="6" cy="18" r="3"></circle>
              <circle cx="18" cy="16" r="3"></circle>
            </svg>
          </div>
          <h3>{t('doing.c3t')}</h3>
          <p>{t('doing.c3p')}</p>
        </article>
      </div>

      <div class="learn-block reveal">
        <span class="eyebrow">{t('learn.eyebrow')}</span>
        <div class="learn-grid">
          <div class="learn-card">
            <div class="learn-card__ic">
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 3v13M12 16l-4-4M12 16l4-4"></path>
                <path d="M5 19h14"></path>
              </svg>
            </div>
            <span class="learn-card__tag">{t('learn.toolkitTag')}</span>
            <h3>{t('learn.toolkitTitle')}</h3>
            <p class="learn-card__sub">{t('learn.toolkitSub')}</p>
            <p>{t('learn.toolkitP')}</p>
            <div class="learn-card__row">
              <a class="btn btn--moss" href={TOOLKIT_URL} target="_blank" rel="noopener">{t('learn.toolkitCta')}</a>
            </div>
          </div>

          <div class="learn-card">
            <div class="learn-card__ic">
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 21v-4a4 4 0 014-4h1M15 13h1a4 4 0 014 4v4"></path>
                <circle cx="9" cy="8" r="3"></circle>
                <circle cx="16" cy="9" r="2.4"></circle>
              </svg>
            </div>
            <span class="learn-card__tag">{t('learn.workshopsTag')}</span>
            <h3>{t('learn.workshopsTitle')}</h3>
            <p>{t('learn.workshopsP')}</p>
            <div class="learn-chips">
              {CHIPS.map((c) => <span>{t(`learn.${c}`)}</span>)}
            </div>
            <div class="learn-card__row learn-card__row--cta">
              <span>{t('learn.ctaText')}</span>
              <a class="btn btn--moss" href={localePath(lang, 'contact')}>{t('learn.ctaBtn')}</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--dark" id="porque" aria-labelledby="porque-h">
    <div class="wrap">
      <div class="why">
        <div class="reveal">
          <span class="eyebrow eyebrow--sprout">{t('why.eyebrow')}</span>
          <p class="why__quote" id="porque-h" set:html={t('why.quote')} />
          <p class="why__text">{t('why.text')}</p>
        </div>
        <div class="stats reveal" id="impacto" aria-label={t('impact.stat1l')}>
          {
            STATS.map((n) => (
              <div class="stat">
                <b>{t(`impact.stat${n}n`)}</b>
                <span>{t(`impact.stat${n}l`)}</span>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="equipo" aria-labelledby="equipo-h">
    <div class="wrap">
      <div class="section__head reveal">
        <span class="eyebrow">{t('team.eyebrow')}</span>
        <h2 id="equipo-h">{t('team.h2')}</h2>
        <p>{t('team.p')}</p>
      </div>

      {
        lead && (
          <div class="lead-member reveal">
            <div class="lead-member__ph">
              {lead.photo && (
                <Image
                  src={lead.photo}
                  alt={lead.photoAlt ?? lead.name}
                  widths={[320, 600]}
                  sizes="(max-width: 760px) 100vw, 33vw"
                />
              )}
            </div>
            <div class="lead-member__body">
              <h3>{lead.name}</h3>
              <div class="lead-member__role">{lead.role}</div>
              <p>{lead.bio}</p>
            </div>
          </div>
        )
      }

      <div class="team">
        {
          members.map((m) => (
            <article class="member reveal">
              <div class="member__ic">
                <svg
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  set:html={ICONS[m.icon]}
                />
              </div>
              <h3>{m.name}</h3>
              <div class="member__role">{m.role}</div>
              <p>{m.bio}</p>
            </article>
          ))
        }
      </div>

      <div class="gallery-strip" aria-label={t('team.h2')}>
        {
          gallery.map((g) => (
            <figure class="reveal">
              <a href={g.instagramUrl} target="_blank" rel="noopener" aria-label="Instagram">
                <Image src={g.image} alt={g.alt} widths={[300, 600]} sizes="(max-width: 760px) 50vw, 25vw" />
                <span class="gallery-strip__ig" aria-hidden="true">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="3" width="18" height="18" rx="5" />
                    <circle cx="12" cy="12" r="4" />
                    <circle cx="17.5" cy="6.5" r="1.1" fill="currentColor" stroke="none" />
                  </svg>
                </span>
              </a>
              {g.credit && <figcaption>📷 {g.credit}</figcaption>}
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--oat section--center section--tight" aria-labelledby="cta2-h">
    <div class="wrap">
      <h2 id="cta2-h" class="cta-h">{t('cta.h2')}</h2>
      <div class="hero__cta hero__cta--center">
        <a class="btn btn--moss" href={localePath(lang, 'collaborate')}>{t('cta.btn1')}</a>
        <a class="btn btn--ghost" href={localePath(lang, 'contact')}>{t('cta.btn2')}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .about-lead {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 44px;
    align-items: center;
  }
  .about-lead h2 {
    font-size: clamp(2rem, 4.4vw, 3.1rem);
    margin: 14px 0 10px;
    color: var(--forest-950);
  }
  .about-lead p {
    color: #4a4f40;
    font-size: 1.06rem;
    margin-top: 14px;
  }
  .values {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 22px;
  }
  .value {
    background: rgba(110, 139, 61, 0.12);
    color: var(--moss-600);
    font-weight: 700;
    font-size: 0.85rem;
    padding: 8px 14px;
    border-radius: 999px;
  }
  .ph {
    border-radius: 26px;
    overflow: hidden;
    aspect-ratio: 4/3;
    background: var(--forest-800);
  }
  .ph :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pillars {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
  }
  .pillar {
    background: #fff;
    border-radius: var(--radius);
    padding: 30px 26px 32px;
    border: 1px solid var(--line);
    position: relative;
    overflow: hidden;
    transition:
      transform 0.3s var(--ease),
      box-shadow 0.3s;
  }
  .pillar:hover {
    transform: translateY(-6px);
    box-shadow: 0 26px 50px -28px rgba(30, 43, 34, 0.5);
  }
  .pillar__ic {
    width: 56px;
    height: 56px;
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
  }
  .pillar:nth-child(1) .pillar__ic {
    background: rgba(110, 139, 61, 0.16);
    color: var(--moss-600);
  }
  .pillar:nth-child(2) .pillar__ic {
    background: rgba(228, 166, 60, 0.18);
    color: var(--clay-deep);
  }
  .pillar:nth-child(3) .pillar__ic {
    background: rgba(192, 116, 62, 0.16);
    color: var(--clay-deep);
  }
  .pillar h3 {
    font-size: 1.35rem;
    margin-bottom: 10px;
  }
  .pillar p {
    color: var(--muted);
    font-size: 0.98rem;
  }
  .pillar__n {
    position: absolute;
    top: 20px;
    right: 24px;
    font-family: var(--ff-display);
    font-weight: 800;
    font-size: 1rem;
    color: var(--line);
  }

  .learn-block {
    margin-top: 48px;
    padding-top: 44px;
    border-top: 1px solid var(--line);
  }
  .learn-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 22px;
    margin-top: 18px;
  }
  .learn-card {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 28px 26px;
    display: flex;
    flex-direction: column;
    transition:
      transform 0.3s var(--ease),
      box-shadow 0.3s;
  }
  .learn-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 26px 50px -28px rgba(30, 43, 34, 0.5);
  }
  .learn-card__ic {
    width: 48px;
    height: 48px;
    border-radius: 14px;
    background: rgba(110, 139, 61, 0.14);
    color: var(--moss-600);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
  }
  .learn-card__tag {
    display: inline-block;
    align-self: flex-start;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--clay-deep);
    background: rgba(192, 116, 62, 0.12);
    padding: 5px 11px;
    border-radius: 999px;
    margin-bottom: 12px;
  }
  .learn-card h3 {
    font-size: 1.3rem;
    margin-bottom: 4px;
  }
  .learn-card__sub {
    color: var(--moss-600);
    font-weight: 700;
    font-size: 0.88rem;
    margin-bottom: 10px;
  }
  .learn-card p {
    color: var(--muted);
    font-size: 0.96rem;
  }
  .learn-card__row {
    margin-top: 20px;
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
  }
  .learn-card__row--cta {
    margin-top: auto;
    padding-top: 16px;
  }
  .learn-card__row--cta span {
    font-weight: 600;
    color: var(--forest-800);
    font-size: 0.92rem;
  }
  .learn-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 16px;
  }
  .learn-chips span {
    background: rgba(110, 139, 61, 0.1);
    color: var(--forest-800);
    font-size: 0.82rem;
    font-weight: 600;
    padding: 6px 12px;
    border-radius: 999px;
  }

  .why {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 56px;
    align-items: center;
  }
  .why__quote {
    font-family: var(--ff-display);
    font-weight: 700;
    font-size: clamp(1.5rem, 3vw, 2.15rem);
    line-height: 1.2;
    color: #fff;
    margin-top: 16px;
  }
  .why__quote :global(span) {
    color: var(--sprout);
  }
  .why__text {
    margin-top: 22px;
    color: rgba(244, 239, 226, 0.82);
    font-size: 1.05rem;
  }
  .stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .stat {
    background: linear-gradient(160deg, rgba(255, 255, 255, 0.07), rgba(255, 255, 255, 0.02));
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: var(--radius);
    padding: 26px 22px;
  }
  .stat b {
    display: block;
    font-family: var(--ff-display);
    font-weight: 800;
    font-size: clamp(2.2rem, 5vw, 3rem);
    color: var(--sprout);
    line-height: 1;
  }
  .stat span {
    display: block;
    margin-top: 8px;
    color: rgba(244, 239, 226, 0.8);
    font-size: 0.92rem;
    font-weight: 500;
  }

  .lead-member {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 36px;
    align-items: center;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    margin-bottom: 22px;
  }
  .lead-member__ph {
    aspect-ratio: 3/4;
    background: var(--forest-800);
  }
  .lead-member__ph :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .lead-member__body {
    padding: 26px 30px 26px 0;
  }
  .lead-member__body h3 {
    font-size: 1.5rem;
  }
  .lead-member__role {
    color: var(--moss-600);
    font-weight: 700;
    font-size: 0.85rem;
    margin: 4px 0 12px;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }
  .lead-member__body p {
    color: var(--muted);
    font-size: 0.98rem;
  }

  .team {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .member {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 24px 22px;
    transition:
      transform 0.3s var(--ease),
      box-shadow 0.3s;
  }
  .member:hover {
    transform: translateY(-5px);
    box-shadow: 0 24px 48px -28px rgba(30, 43, 34, 0.5);
  }
  .member__ic {
    width: 48px;
    height: 48px;
    border-radius: 14px;
    background: rgba(110, 139, 61, 0.14);
    color: var(--moss-600);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
  }
  .member h3 {
    font-size: 1.18rem;
  }
  .member__role {
    color: var(--moss-600);
    font-weight: 700;
    font-size: 0.8rem;
    margin: 3px 0 10px;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }
  .member p {
    color: var(--muted);
    font-size: 0.92rem;
  }

  .gallery-strip {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
    margin-top: 40px;
  }
  .gallery-strip figure {
    border-radius: 16px;
    overflow: hidden;
    aspect-ratio: 1/1;
    position: relative;
    background: var(--forest-800);
  }
  .gallery-strip figure a {
    display: block;
    position: relative;
    width: 100%;
    height: 100%;
  }
  .gallery-strip :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s var(--ease);
  }
  .gallery-strip figure:hover :global(img) {
    transform: scale(1.06);
  }
  .gallery-strip figcaption {
    position: absolute;
    left: 8px;
    bottom: 8px;
    font-size: 0.66rem;
    color: #fff;
    background: rgba(22, 33, 26, 0.55);
    padding: 3px 8px;
    border-radius: 7px;
  }
  .gallery-strip__ig {
    position: absolute;
    top: 8px;
    right: 8px;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: rgba(22, 33, 26, 0.55);
    backdrop-filter: blur(3px);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    opacity: 0;
    transform: scale(0.7);
    transition:
      opacity 0.25s ease,
      transform 0.25s ease;
  }
  .gallery-strip figure:hover .gallery-strip__ig {
    opacity: 1;
    transform: scale(1);
  }

  .cta-h {
    font-size: clamp(1.8rem, 4vw, 2.4rem);
    margin-bottom: 20px;
    color: var(--forest-950);
  }

  @media (max-width: 820px) {
    .about-lead,
    .pillars,
    .learn-grid,
    .why {
      grid-template-columns: 1fr;
    }
    .about-lead {
      gap: 26px;
    }
    .why {
      gap: 34px;
    }
    .team {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 760px) {
    .lead-member {
      grid-template-columns: 1fr;
    }
    .lead-member__body {
      padding: 0 22px 24px;
    }
    .lead-member__ph {
      aspect-ratio: 16/10;
    }
    .gallery-strip {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 560px) {
    .team {
      grid-template-columns: 1fr;
    }
  }
</style>
