---
import Base from '../../layouts/Base.astro';
import { pathsFor, type Locale } from '../../i18n';

export const getStaticPaths = () => pathsFor('about');

type Props = { lang: Locale };
const { lang } = Astro.props;

/* Fase 1: solo el esqueleto. Ver nota en index.astro. */
const title = 'Sobre nosotras · Equipo y misión · Back to the Roots';
const description =
  'Conoce a Back to the Roots: nuestra misión, por qué trabajamos por la educación ambiental y la expresión artística, y el equipo que lo hace posible.';
---

<Base lang={lang} page="about" title={title} description={description}>
  <section class="section">
    <div class="wrap">
      <h1>Una comunidad que crece desde la raíz</h1>
    </div>
  </section>
</Base>
