---
import Base from '../../layouts/Base.astro';
import { pathsFor, type Locale } from '../../i18n';

export const getStaticPaths = () => pathsFor('collaborate');

type Props = { lang: Locale };
const { lang } = Astro.props;

/* Fase 1: solo el esqueleto. Ver nota en index.astro. */
const title = 'Colabora con nosotras · Red de aliados · Back to the Roots';
const description =
  'Descubre cómo colaborar con Back to the Roots: como joven, entidad, voluntario o difundiendo nuestros proyectos. Explora nuestra red de colaboraciones en el mapa.';
---

<Base lang={lang} page="collaborate" title={title} description={description}>
  <section class="section">
    <div class="wrap">
      <h1>Conéctate a nuestro micelio</h1>
    </div>
  </section>
</Base>
