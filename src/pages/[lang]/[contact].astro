---
import { getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { localePath, pathsFor, useTranslations, type Locale } from '../../i18n';
import { usePageText } from '../../lib/content';

export const getStaticPaths = () => pathsFor('contact');

type Props = { lang: Locale };
const { lang } = Astro.props;

const page = await getEntry('pages', 'contact');
if (!page) throw new Error('Falta src/content/pages/contact.json');
const t = usePageText(page.data, 'contact', lang);
const ui = useTranslations(lang);

const site = await getEntry('config', 'site');

const SOCIAL_ICONS: Record<string, string> = {
  Instagram:
    '<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1.2" fill="currentColor" stroke="none"/>',
  Facebook: '<path d="M14 9V7c0-1 .5-1.5 1.5-1.5H17V2h-2.5C11.5 2 10 3.8 10 6.5V9H8v3.5h2V22h3.5v-9.5H16l.5-3.5H14z"/>',
  YouTube: '<rect x="2" y="5" width="20" height="14" rx="4"/><path d="M10 9l5 3-5 3z" fill="currentColor"/>',
};
---

<Base lang={lang} page="contact" title={t('seo.title')} description={t('seo.description')}>
  <section class="section section--contact" aria-labelledby="contacto-h">
    <div class="wrap">
      <div class="crumb">
        <a href={localePath(lang)}>{ui('common.crumb.home')}</a>
        <span>／</span>
        <span>{ui('common.crumb.contact')}</span>
      </div>

      <div class="contact">
        <div class="contact__aside reveal">
          <span class="eyebrow eyebrow--sprout">{t('intro.eyebrow')}</span>
          <h1 id="contacto-h">{t('intro.h1')}</h1>
          <p>{t('intro.p')}</p>

          <div class="contact__ways">
            {
              site && (
                <div class="cway">
                  <span class="cway__ic">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <rect x="3" y="5" width="18" height="14" rx="2" />
                      <path d="M3 7l9 6 9-6" />
                    </svg>
                  </span>
                  <a href={`mailto:${site.data.email}`}>{site.data.email}</a>
                </div>
              )
            }
            <div class="cway">
              <span class="cway__ic">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M12 21s-7-6.3-7-11a7 7 0 0114 0c0 4.7-7 11-7 11z"></path>
                  <circle cx="12" cy="10" r="2.5"></circle>
                </svg>
              </span>
              <span>{t('intro.loc')}</span>
            </div>
          </div>

          {
            site && (
              <div class="socials" aria-label={ui('common.footer.connect')}>
                {site.data.social.map((s) => (
                  <a href={s.url} target="_blank" rel="noopener" aria-label={s.name}>
                    <svg
                      width="22"
                      height="22"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      set:html={SOCIAL_ICONS[s.name] ?? ''}
                    />
                  </a>
                ))}
              </div>
            )
          }
        </div>

        {/* El envío se conecta a Web3Forms en la fase 5, cuando la ONG facilite
            su access key. Hasta entonces el formulario se ve pero no envía:
            está anotado en CLAUDE.md §11. */}
        <form class="form reveal" id="cform" method="POST" action="https://api.web3forms.com/submit" novalidate>
          <input type="hidden" name="access_key" value="" />
          <input type="hidden" name="redirect" value={new URL(localePath(lang, 'thanks'), Astro.site).href} />
          <p class="hp-field" aria-hidden="true">
            <label>
              No rellenar si eres humano:
              <input name="botcheck" tabindex="-1" autocomplete="off" />
            </label>
          </p>
          <div class="field">
            <label for="cn">{t('form.name')}</label>
            <input id="cn" name="name" type="text" required autocomplete="name" placeholder={t('form.namePlaceholder')} />
          </div>
          <div class="field">
            <label for="ce">{t('form.email')}</label>
            <input id="ce" name="email" type="email" required autocomplete="email" placeholder="tu@email.com" />
          </div>
          <div class="field">
            <label for="cm">{t('form.message')}</label>
            <textarea id="cm" name="message" required placeholder={t('form.messagePlaceholder')}></textarea>
          </div>
          <button class="btn btn--moss form__submit" type="submit">{t('form.send')}</button>
        </form>
      </div>
    </div>
  </section>

  <section class="section section--oat section--center" aria-labelledby="faq-h">
    <div class="wrap">
      <h2 id="faq-h" class="faq-h">{t('faq.h2')}</h2>
      <div class="hero__cta hero__cta--center">
        <a class="btn btn--ghost" href={localePath(lang, 'opportunities')}>{t('faq.btn1')}</a>
        <a class="btn btn--ghost" href={localePath(lang, 'collaborate')}>{t('faq.btn2')}</a>
        <a class="btn btn--ghost" href={localePath(lang, 'about')}>{t('faq.btn3')}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .section--contact {
    background: var(--forest-950);
    color: var(--oat-100);
    padding-top: 56px;
  }
  .crumb {
    display: flex;
    gap: 8px;
    align-items: center;
    font-size: 0.85rem;
    color: rgba(244, 239, 226, 0.6);
    margin-bottom: 16px;
  }
  .crumb a {
    color: rgba(244, 239, 226, 0.85);
    font-weight: 600;
  }
  .crumb a:hover {
    color: var(--sprout);
  }

  .contact {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: start;
  }
  .contact__aside h1 {
    font-size: clamp(2rem, 4vw, 2.8rem);
    color: #fff;
    margin-top: 14px;
  }
  .contact__aside p {
    color: rgba(244, 239, 226, 0.82);
    margin-top: 16px;
    font-size: 1.05rem;
  }
  .contact__ways {
    margin-top: 28px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .cway {
    display: flex;
    align-items: center;
    gap: 14px;
    color: var(--oat-100);
    font-weight: 600;
  }
  .cway__ic {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--sprout);
    flex: 0 0 auto;
  }
  .cway a {
    border-bottom: 1px solid rgba(183, 206, 85, 0.5);
  }
  .socials {
    display: flex;
    gap: 12px;
    margin-top: 26px;
  }
  .socials a {
    width: 46px;
    height: 46px;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--oat-100);
    transition: 0.2s;
  }
  .socials a:hover {
    background: var(--sprout);
    color: var(--forest-950);
    transform: translateY(-3px);
  }

  .form {
    background: #fff;
    border-radius: 24px;
    padding: 30px;
    box-shadow: 0 30px 60px -34px rgba(0, 0, 0, 0.5);
  }
  .field {
    margin-bottom: 16px;
  }
  .field label {
    display: block;
    font-weight: 700;
    font-size: 0.85rem;
    margin-bottom: 7px;
    color: var(--forest-900);
  }
  .field input,
  .field textarea {
    width: 100%;
    padding: 13px 15px;
    border: 1.5px solid var(--line);
    border-radius: 12px;
    font-family: inherit;
    font-size: 1rem;
    background: var(--oat-50);
    color: var(--ink);
    transition: border-color 0.2s;
  }
  .field input:focus,
  .field textarea:focus {
    border-color: var(--moss-500);
  }
  .field textarea {
    resize: vertical;
    min-height: 120px;
  }
  .form__submit {
    width: 100%;
  }
  /* Trampa anti-spam: invisible para personas, visible para bots. */
  .hp-field {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .faq-h {
    font-size: clamp(1.6rem, 3.6vw, 2.2rem);
    color: var(--forest-950);
    margin-bottom: 18px;
  }

  @media (max-width: 820px) {
    .contact {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
</style>
