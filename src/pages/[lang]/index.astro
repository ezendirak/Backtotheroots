---
import { Image } from 'astro:assets';
import { getCollection, getEntry } from 'astro:content';
import logoFull from '../../assets/img/logo-full.png';
import heroNature from '../../assets/img/hero-nature.jpg';
import ProjectCard from '../../components/ProjectCard.astro';
import Base from '../../layouts/Base.astro';
import { homePaths, localePath, type Locale } from '../../i18n';
import { pickText, usePageText } from '../../lib/content';

export const getStaticPaths = homePaths;

type Props = { lang: Locale };
const { lang } = Astro.props;

const page = await getEntry('pages', 'home');
if (!page) throw new Error('Falta src/content/pages/home.json');
const t = usePageText(page.data, 'home', lang);

const projects = (await getCollection('projects', (p) => p.data.featured)).sort(
  (a, b) => (a.data.homeOrder ?? 99) - (b.data.homeOrder ?? 99)
);

const [opportunity] = (await getCollection('opportunities', (o) => o.data.status === 'abierta')).sort(
  (a, b) => a.data.order - b.data.order
);

/* Las preguntas llevan al apartado correspondiente de /nosotras. */
const QUESTIONS = [
  { field: 'q1', href: `${localePath(lang, 'about')}#quienes` },
  { field: 'q2', href: `${localePath(lang, 'about')}#hacemos` },
  { field: 'q3', href: `${localePath(lang, 'about')}#porque` },
  { field: 'q4', href: localePath(lang, 'collaborate') },
  { field: 'q5', href: `${localePath(lang, 'about')}#impacto` },
];

---

<Base lang={lang} page="home" title={t('seo.title')} description={t('seo.description')}>
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap">
      <div class="hero__grid">
        <div class="hero__copy reveal">
          <span class="eyebrow hero__eyebrow">{t('hero.eyebrow')}</span>
          <h1 id="hero-title" set:html={t('hero.title')} />
          <p class="hero__sub">{t('hero.sub')}</p>
          <div class="hero__cta">
            <a class="btn btn--moss" href={localePath(lang, 'projects')}>{t('hero.cta1')}</a>
            <a class="btn btn--ghost" href={localePath(lang, 'collaborate')}>{t('hero.cta2')}</a>
          </div>
          <div class="hero__scroll">
            <span class="hero__root" aria-hidden="true">
              <svg viewBox="0 0 24 40" width="20" height="34">
                <circle cx="12" cy="5" r="2.1" fill="var(--moss-600)"></circle>
                <path
                  class="hero__root-grow"
                  d="M12 7c0 7-3.4 11-5.6 15.5M12 7c0 9 0 15.5 0 22M12 7c0 7 3.4 11 5.6 15.5"
                  stroke="var(--moss-500)"
                  stroke-width="1.6"
                  fill="none"
                  stroke-linecap="round"></path>
              </svg>
            </span>
            <span>{t('hero.scroll')}</span>
          </div>
        </div>
        <div class="hero__art reveal">
          <div class="hero__logo" aria-hidden="true">
            <Image src={logoFull} alt="" widths={[280, 380, 760]} sizes="(max-width: 860px) 280px, 380px" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="qbar" aria-label={t('questions.q1')}>
    <div class="wrap">
      <div class="qbar__inner">
        {
          QUESTIONS.map((q, i) => (
            <a class="qchip" href={q.href}>
              <b>{String(i + 1).padStart(2, '0')}</b>
              <span>{t(`questions.${q.field}`)}</span>
            </a>
          ))
        }
      </div>
    </div>
  </div>

  <section class="section" aria-labelledby="who-h">
    <div class="wrap">
      <div class="about-lead">
        <div class="reveal">
          <span class="eyebrow">{t('who.eyebrow')}</span>
          <h2 id="who-h">{t('who.h2')}</h2>
          <p>{t('who.p')}</p>
          <div class="hero__cta hero__cta--spaced">
            <a class="btn btn--moss" href={localePath(lang, 'about')}>{t('who.cta')}</a>
          </div>
        </div>
        <div class="reveal">
          <div class="ph">
            <Image
              src={heroNature}
              alt="Equipo de Back to the Roots trabajando en un proyecto en plena naturaleza"
              widths={[480, 760, 1024]}
              sizes="(max-width: 820px) 100vw, 50vw"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--oat" aria-labelledby="do-h">
    <div class="wrap">
      <div class="section__head reveal">
        <span class="eyebrow">{t('doing.eyebrow')}</span>
        <h2 id="do-h">{t('doing.h2')}</h2>
        <p>{t('doing.p')}</p>
      </div>
      <div class="pillars">
        <article class="pillar reveal">
          <span class="pillar__n">01</span>
          <div class="pillar__ic">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2C7 5 4 9 4 14a8 8 0 0016 0c0-5-3-9-8-12z"></path>
              <path d="M12 22v-8M12 16c-2 0-4-1-5-3"></path>
            </svg>
          </div>
          <h3>{t('doing.c1t')}</h3>
          <p>{t('doing.c1p')}</p>
        </article>
        <article class="pillar reveal">
          <span class="pillar__n">02</span>
          <div class="pillar__ic">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="9" cy="8" r="3"></circle>
              <circle cx="17" cy="10" r="2.5"></circle>
              <path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6M15.5 20c0-2 .8-3.8 2-5"></path>
            </svg>
          </div>
          <h3>{t('doing.c2t')}</h3>
          <p>{t('doing.c2p')}</p>
        </article>
        <article class="pillar reveal">
          <span class="pillar__n">03</span>
          <div class="pillar__ic">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 18V5l12-2v13"></path>
              <circle cx="6" cy="18" r="3"></circle>
              <circle cx="18" cy="16" r="3"></circle>
            </svg>
          </div>
          <h3>{t('doing.c3t')}</h3>
          <p>{t('doing.c3p')}</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="proj-h">
    <div class="wrap">
      <div class="section__head reveal">
        <span class="eyebrow">{t('projects.eyebrow')}</span>
        <h2 id="proj-h">{t('projects.h2')}</h2>
        <p>{t('projects.p')}</p>
      </div>
      <div class="projects">
        {projects.map((project) => <ProjectCard project={project} lang={lang} short />)}
      </div>
      <div class="hero__cta hero__cta--center">
        <a class="btn btn--ghost" href={localePath(lang, 'projects')}>{t('projects.cta')}</a>
      </div>
    </div>
  </section>

  {
    opportunity && (
      <section class="section section--dark" aria-labelledby="opp-h">
        <div class="wrap">
          <div class="section__head reveal">
            <span class="eyebrow eyebrow--sprout">{t('opportunity.eyebrow')}</span>
            <h2 id="opp-h">{t('opportunity.h2')}</h2>
          </div>
          <div class="opp reveal">
            <div class="opp__poster">
              {opportunity.data.flag && <span class="flag">{pickText(opportunity.data.flag, lang)}</span>}
              <Image
                src={opportunity.data.poster}
                alt={pickText(opportunity.data.posterAlt, lang)}
                widths={[400, 700]}
                sizes="(max-width: 820px) 100vw, 40vw"
              />
            </div>
            <div class="opp__body">
              <h3>{opportunity.data.title}</h3>
              <span class="opp__where">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M12 21s-7-6.3-7-11a7 7 0 0114 0c0 4.7-7 11-7 11z" />
                  <circle cx="12" cy="10" r="2.5" />
                </svg>
                <span>{pickText(opportunity.data.whereShort ?? opportunity.data.where, lang)}</span>
              </span>
              <p>{pickText(opportunity.data.summaryShort ?? opportunity.data.summary, lang)}</p>
              <div class="opp__cta">
                <a class="btn btn--sun" href={localePath(lang, 'opportunities')}>{t('opportunity.cta1')}</a>
                {opportunity.data.signupUrl && (
                  <a class="btn btn--light" href={opportunity.data.signupUrl} target="_blank" rel="noopener">
                    {t('opportunity.cta2')}
                  </a>
                )}
              </div>
            </div>
          </div>
        </div>
      </section>
    )
  }

  <section class="section section--oat section--center" aria-labelledby="cta-h">
    <div class="wrap">
      <span class="eyebrow eyebrow--center">{t('cta.eyebrow')}</span>
      <h2 id="cta-h" class="cta-h">{t('cta.h2')}</h2>
      <div class="hero__cta hero__cta--center">
        <a class="btn btn--moss" href={localePath(lang, 'collaborate')}>{t('cta.btn1')}</a>
        <a class="btn btn--ghost" href={localePath(lang, 'contact')}>{t('cta.btn2')}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    position: relative;
    background:
      radial-gradient(120% 90% at 85% -10%, rgba(228, 166, 60, 0.2), transparent 55%),
      radial-gradient(120% 120% at -10% 110%, rgba(110, 139, 61, 0.28), transparent 55%),
      linear-gradient(180deg, #fbf9f2, #f1ead9);
    overflow: hidden;
  }
  .hero__grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 44px;
    align-items: center;
    padding: 72px 0 84px;
  }
  .hero h1 {
    font-size: clamp(2.9rem, 7vw, 5.3rem);
    color: var(--forest-950);
  }
  .hero h1 :global(em) {
    font-style: normal;
    color: var(--moss-600);
    position: relative;
  }
  .hero h1 :global(em)::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.06em;
    height: 0.14em;
    background: var(--sprout);
    border-radius: 4px;
    z-index: -1;
    opacity: 0.9;
  }
  .hero__sub {
    font-size: clamp(1.05rem, 2.2vw, 1.35rem);
    color: #414636;
    max-width: 34ch;
    margin: 22px 0 30px;
    font-weight: 500;
  }
  .hero__scroll {
    margin-top: 34px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--muted);
    font-weight: 600;
    font-size: 0.88rem;
  }
  .hero__root {
    flex: 0 0 auto;
    display: flex;
  }
  .hero__root-grow {
    stroke-dasharray: 26;
    stroke-dashoffset: 26;
    animation: rootgrow 2.4s ease-in-out infinite;
  }
  @keyframes rootgrow {
    0% {
      stroke-dashoffset: 26;
      opacity: 0.4;
    }
    55%,
    85% {
      stroke-dashoffset: 0;
      opacity: 1;
    }
    100% {
      stroke-dashoffset: 26;
      opacity: 0.4;
    }
  }

  .hero__logo {
    position: relative;
    max-width: 380px;
    margin-inline: auto;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }
  .hero__logo::before {
    content: '';
    position: absolute;
    inset: 6%;
    background: radial-gradient(circle, rgba(183, 206, 85, 0.4), rgba(110, 139, 61, 0.14) 58%, transparent 72%);
    border-radius: 50%;
    filter: blur(1px);
    z-index: 0;
  }
  .hero__logo :global(img) {
    position: relative;
    z-index: 1;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 20px 36px rgba(30, 43, 34, 0.28));
    animation: heroFloat 6s ease-in-out infinite;
  }
  @keyframes heroFloat {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-10px);
    }
  }

  @media (max-width: 860px) {
    .hero__grid {
      grid-template-columns: 1fr;
      gap: 10px;
      padding: 44px 0 60px;
    }
    .hero__logo {
      max-width: 280px;
      order: -1;
      margin-bottom: 8px;
    }
  }

  .qbar {
    background: var(--forest-950);
    color: var(--oat-100);
  }
  .qbar__inner {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    padding: 18px 0;
    scrollbar-width: none;
  }
  .qbar__inner::-webkit-scrollbar {
    display: none;
  }
  .qchip {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 11px 16px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    color: var(--oat-100);
    font-weight: 600;
    font-size: 0.9rem;
    transition:
      background 0.2s,
      border-color 0.2s,
      transform 0.2s;
  }
  .qchip:hover {
    background: rgba(183, 206, 85, 0.16);
    border-color: var(--sprout);
    transform: translateY(-2px);
  }
  .qchip b {
    color: var(--sprout);
    font-family: var(--ff-display);
    font-weight: 700;
  }

  .about-lead {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 44px;
    align-items: center;
  }
  .about-lead h2 {
    font-size: clamp(2rem, 4.4vw, 3.1rem);
    margin: 14px 0 10px;
    color: var(--forest-950);
  }
  .about-lead p {
    color: #4a4f40;
    font-size: 1.06rem;
    margin-top: 14px;
  }
  .ph {
    border-radius: 26px;
    overflow: hidden;
    aspect-ratio: 4/3;
    background: var(--forest-800);
  }
  .ph :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pillars {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
  }
  .pillar {
    background: #fff;
    border-radius: var(--radius);
    padding: 30px 26px 32px;
    border: 1px solid var(--line);
    position: relative;
    overflow: hidden;
    transition:
      transform 0.3s var(--ease),
      box-shadow 0.3s;
  }
  .pillar:hover {
    transform: translateY(-6px);
    box-shadow: 0 26px 50px -28px rgba(30, 43, 34, 0.5);
  }
  .pillar__ic {
    width: 56px;
    height: 56px;
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
  }
  .pillar:nth-child(1) .pillar__ic {
    background: rgba(110, 139, 61, 0.16);
    color: var(--moss-600);
  }
  .pillar:nth-child(2) .pillar__ic {
    background: rgba(228, 166, 60, 0.18);
    color: var(--clay-deep);
  }
  .pillar:nth-child(3) .pillar__ic {
    background: rgba(192, 116, 62, 0.16);
    color: var(--clay-deep);
  }
  .pillar h3 {
    font-size: 1.35rem;
    margin-bottom: 10px;
  }
  .pillar p {
    color: var(--muted);
    font-size: 0.98rem;
  }
  .pillar__n {
    position: absolute;
    top: 20px;
    right: 24px;
    font-family: var(--ff-display);
    font-weight: 800;
    font-size: 1rem;
    color: var(--line);
  }
  @media (max-width: 820px) {
    .pillars {
      grid-template-columns: 1fr;
    }
    .about-lead {
      grid-template-columns: 1fr;
      gap: 26px;
    }
  }

  .projects {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 22px;
  }
  @media (max-width: 720px) {
    .projects {
      grid-template-columns: 1fr;
    }
  }

  .opp {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    background: linear-gradient(150deg, var(--moss-600), var(--forest-800));
    border-radius: 28px;
    overflow: hidden;
    color: #fff;
    box-shadow: 0 30px 60px -34px rgba(30, 43, 34, 0.7);
  }
  .opp__poster {
    position: relative;
    min-height: 320px;
    background: var(--forest-800);
  }
  .opp__poster .flag {
    position: absolute;
    top: 18px;
    left: 18px;
    z-index: 2;
    background: #fff;
    color: var(--clay-deep);
    font-weight: 800;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    padding: 7px 13px;
    border-radius: 999px;
    text-transform: uppercase;
  }
  .opp__poster :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .opp__body {
    padding: 38px 40px;
  }
  .opp__body h3 {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    margin-bottom: 8px;
  }
  .opp__where {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
    color: var(--sprout);
    margin-bottom: 16px;
    font-size: 0.95rem;
  }
  .opp__body > p {
    color: rgba(255, 255, 255, 0.86);
    margin-bottom: 20px;
  }
  .opp__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  @media (max-width: 820px) {
    .opp {
      grid-template-columns: 1fr;
    }
    .opp__poster {
      min-height: 220px;
    }
  }

  .cta-h {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    margin: 14px auto 22px;
    max-width: 24ch;
    color: var(--forest-950);
  }
</style>
