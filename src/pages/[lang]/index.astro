---
import Base from '../../layouts/Base.astro';
import { homePaths, type Locale } from '../../i18n';

export const getStaticPaths = homePaths;

type Props = { lang: Locale };
const { lang } = Astro.props;

/* Fase 1: solo el esqueleto. El título, la descripción y el contenido se
   migran a src/content/ en la fase 2, con su versión en cada idioma; hasta
   entonces las tres rutas muestran el texto castellano de la web actual. */
const title = 'Back to the Roots · Educación ambiental y expresión artística para la juventud';
const description =
  'Experiencias educativas que reconectan a la juventud con la naturaleza, las tradiciones y el arte a través de intercambios y formaciones educativas en Cataluña y Europa.';
---

<Base lang={lang} page="home" title={title} description={description}>
  <section class="section">
    <div class="wrap">
      <h1>Back to the Roots</h1>
    </div>
  </section>
</Base>
